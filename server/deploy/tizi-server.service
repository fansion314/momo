[Unit]
Description=New group tizi subscription service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tizi-server
Group=tizi-server
StateDirectory=tizi-server
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/tizi-server.env
ExecStart=/usr/local/bin/tizi-server --database /var/lib/tizi-server/tizi.db serve --listen 127.0.0.1:9876
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tizi-server

[Install]
WantedBy=multi-user.target
