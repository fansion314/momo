// systemd-resolved supplies the interface as a polkit action detail. Limit
// this grant to the application's default TUN device and active local admins.
polkit.addRule(function (action, subject) {
  if (!subject.local || !subject.active || !subject.isInGroup('wheel') || action.lookup('interface') !== 'Mihomo') return

  if (
    action.id === 'org.freedesktop.resolve1.set-dns-servers' ||
    action.id === 'org.freedesktop.resolve1.set-domains' ||
    action.id === 'org.freedesktop.resolve1.set-default-route' ||
    action.id === 'org.freedesktop.resolve1.revert'
  ) {
    return polkit.Result.YES
  }
})
