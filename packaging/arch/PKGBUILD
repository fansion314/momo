export LANG=C.UTF-8 LC_ALL=C.UTF-8

pkgname=clash-momo
pkgver=2.0.4
pkgrel=2
pkgdesc='Desktop client for mihomomo'
arch=('x86_64')
url='https://github.com/fansion314/momo'
license=('GPL-3.0-only')
depends=('electron' 'mihomomo>=1.19.33-2' 'gtk3' 'libnotify' 'libsecret' 'xdg-utils' 'wl-clipboard' 'polkit')
makedepends=('git' 'nodejs' 'pnpm' 'unzip')
source=("git+https://github.com/fansion314/momo.git#commit=@COMMIT@" 'clash-momo' 'clash-momo.desktop')
sha256sums=('SKIP' '@LAUNCHER_SHA@' '@DESKTOP_SHA@')
options=('!strip' '!debug')

build() {
  cd "$srcdir/momo"
  pnpm install --frozen-lockfile --ignore-scripts
  node scripts/prepare-arch.mjs
  pnpm --package=vite-plus@1.4.0 dlx vp run build:linux
  pnpm --filter clash-momo deploy --ignore-scripts --legacy --prod "$srcdir/app"
  cp -a out extra "$srcdir/app/"
  # Keep deployed icons: Electron Vite references some public assets here.
  # Replace only generated runtime resource directories in the new staging tree.
  mkdir -p "$srcdir/app/resources"
  if [[ -L "$srcdir/app/resources/extra" ]]; then
    rm "$srcdir/app/resources/extra"
  fi
  rm -rf "$srcdir/app/resources/files" "$srcdir/app/resources/sidecar"
  ln -s ../extra/files "$srcdir/app/resources/files"
  ln -s ../extra/sidecar "$srcdir/app/resources/sidecar"
  test -s "$srcdir/app/resources/icon.png"
  test -s "$srcdir/app/resources/iconTemplate.png"
  test -s "$srcdir/app/resources/subStoreIcon.png"
  test -s "$srcdir/app/resources/files/sub-store.bundle.cjs"
  test -s "$srcdir/app/resources/files/country.mmdb"
  test -s "$srcdir/app/resources/sidecar/sysproxy.linux-x64-gnu.node"
}

package() {
  install -dm755 "$pkgdir/usr/lib/clash-momo"
  cp -a "$srcdir/app/." "$pkgdir/usr/lib/clash-momo/"
  install -Dm755 "$srcdir/clash-momo" "$pkgdir/usr/bin/clash-momo"
  install -Dm644 "$srcdir/clash-momo.desktop" "$pkgdir/usr/share/applications/world.fansionia.clash-momo.desktop"
  install -Dm644 "$srcdir/momo/resources/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/world.fansionia.clash-momo.png"
  install -Dm644 "$srcdir/momo/packaging/arch/49-clash-momo-resolved.rules" "$pkgdir/usr/share/polkit-1/rules.d/49-clash-momo-resolved.rules"
}
